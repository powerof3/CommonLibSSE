{
  "name": "commonlib-shared",
  "version-date": "2026-08-21",
  "description": "Shared library for CommonLib projects",
  "homepage": "https://github.com/libxse/commonlib-shared",
  "license": "GPL-3.0-or-later",
  "dependencies": [
    {
      "name": "spdlog",
      "default-features": false,
      "features": [ "wchar" ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "ini": {
      "description": "REX::INI settings support",
      "dependencies": [ "simpleini" ]
    },
    "json": {
      "description": "REX::JSON settings support",
      "dependencies": [ "glaze" ]
    },
    "toml": {
      "description": "REX::TOML settings support",
      "dependencies": [ "toml11" ]
    },
    "xbyak": {
      "description": "xbyak trampoline support",
      "dependencies": [ "xbyak" ]
    }
  }
}
